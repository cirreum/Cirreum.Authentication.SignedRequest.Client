<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>Cirreum.Authentication.SignedRequest.Client</AssemblyName>
		<RootNamespace>Cirreum.Authentication.SignedRequest</RootNamespace>
		<Description>Client SDK for HMAC signed request authentication. Sign outgoing HTTP requests and validate incoming webhooks with HMAC-SHA256 signatures. Outbound companion to Cirreum.Authentication.SignedRequest (server-side scheme). Renamed from Cirreum.Authorization.SignedRequest.Client.</Description>
		<PackageTags>cirreum;authentication;signedrequest;hmac;client;http;webhook</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<!--
			Outbound signer + standalone webhook validator. Consumes the shared RFC 9421 / RFC 9530 primitives
			(signature-base builder, wire parser, Content-Digest, HMAC algorithm) from Cirreum.SignedRequest
			(ADR-0021 §8) so a client-signed request verifies byte-identically server-side — and nothing more, so
			the SDK stays lightweight (no auth-provider / ASP.NET-pipeline tail). The ASP.NET shared framework
			powers only the HttpRequest webhook-validation helpers.
		-->
		<PackageReference Include="Cirreum.SignedRequest" Version="1.0.0" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

</Project>
